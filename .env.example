# Copy this file to .env and fill in your values.

# Required: Groq API key for the LLM. Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional: password gate for the Streamlit app.
# If set, users must enter this password before reaching the chat UI.
# Required when exposing the app publicly (e.g. via ngrok).
# Leave blank for local-only development.
APP_PASSWORD=

# Optional: User-Agent sent to SEC EDGAR by fetch_sec.py.
# SEC asks for a real contact email; replace before running fetch_sec.py.
SEC_USER_AGENT=FinRAG Demo your-email@example.com
